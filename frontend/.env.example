# ─── SEO ──────────────────────────────────────────────────────────
# Канонический адрес сайта: без слэша на конце, с протоколом.
# Из него строятся canonical, og:url, sitemap.xml и robots.txt.
# ВАЖНО: переменная NEXT_PUBLIC_*, то есть вшивается в бандл при сборке.
# В Docker её нужно передать build-аргументом (docker-compose.prod.yml),
# задать только в runtime недостаточно.
# Dev: http://localhost  |  Prod: https://ваш-домен.ru
NEXT_PUBLIC_SITE_URL=https://astrix.ru

# Коды подтверждения прав в вебмастерах (значение атрибута content).
# Пусто — метатег просто не выводится.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ─── Offer identity ───────────────────────────────────────────────
NEXT_PUBLIC_OFFER_ID=

# ─── Referral ─────────────────────────────────────────────────────
NEXT_PUBLIC_REF_TTL_DAYS=7

# ─── Backend (FastAPI) ────────────────────────────────────────────
# Используется только server-side (checkout-start route).
# Dev: http://localhost:8000  |  Prod (docker): http://backend:8000
BACKEND_URL=http://localhost:8000

# ─── Tracking Service (S2S, server-only) ──────────────────────────
TS_URL=https://leadpeak.pro/tracking
TS_API_KEY=

# ─── Payment form (Variant B — собственная форма с CP виджетом) ───
# Если используешь Variant A (редирект LeadPeak) — PS_* и CP_* не нужны.
#
# PS_URL, PS_API_KEY — server-only, не должны попасть в клиентский бандл
PS_URL=https://leadpeak.pro/payment
PS_API_KEY=
# Куда вернуть пользователя после оплаты (например: https://yoursite.com/lk)
NEXT_PUBLIC_PAYMENT_BACK_URL=
# CloudPayments Public ID — можно на клиенте
NEXT_PUBLIC_CP_PUBLIC_ID=

# ─── Admin ────────────────────────────────────────────────────────
ADMIN_PASSWORD=
