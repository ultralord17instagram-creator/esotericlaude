# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — шаблон переменных окружения
#
# Скопировать в .env и заполнить реальными значениями:
#   cp .env.example .env
#
# AUTH_SERVICE_API_KEY и OFFER_ID получить у команды партнёрки
# при регистрации оффера.
#
# НИКОГДА не коммитить .env в git (уже в .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════

# ── База данных ──────────────────────────────────────────────────────────────
# PostgreSQL через asyncpg.
# Dev: используй postgres из docker-compose.dev.yml (уже настроен)
# Prod: укажи реальный адрес PostgreSQL сервера
DATABASE_URL=postgresql+asyncpg://offer_user:secret@postgres:5432/offer_db

# ── Auth Service партнёрки ────────────────────────────────────────────────────
# URL куда ходить за верификацией токенов.
# Источник: уточнить у команды партнёрки.
AUTH_SERVICE_URL=https://auth.your-partner.com

# API-ключ этого оффера в auth_service.
# Источник: получить у команды партнёрки при регистрации оффера. СЕКРЕТ.
AUTH_SERVICE_API_KEY=your-offer-api-key-here

# ── Идентификатор оффера ─────────────────────────────────────────────────────
# Строковый ID оффера в системе партнёрки.
# Источник: получить у команды партнёрки при регистрации оффера.
OFFER_ID=your-offer-id

# ── Payment Service партнёрки ─────────────────────────────────────────────────
# URL payment_service для получения тарифа оффера.
# Источник: уточнить у команды партнёрки при подключении оффера.
PAYMENT_SERVICE_URL=https://payment.your-partner.com

# ── Pay Form партнёрки ────────────────────────────────────────────────────────
# URL платёжной формы — куда редиректить пользователя при оформлении подписки.
# Источник: уточнить у команды партнёрки при подключении оффера.
PAY_FORM_URL=https://pay.your-partner.com

# ══ Frontend, build-time (NEXT_PUBLIC_*) ══════════════════════════════════════
# ВСЁ, что ниже до раздела «Режим отладки», docker-compose.prod.yml передаёт
# в сборку фронта как build args и читает ИМЕННО ОТСЮДА, из корневого .env.
# Положить эти переменные в frontend/.env недостаточно: env_file задаёт
# окружение уже запущенного контейнера, а NEXT_PUBLIC_* вшиваются в JS-бандл
# на этапе сборки. Оставите пустым — в бандл уедет пустая строка.
# После любой правки: docker compose -f docker-compose.prod.yml build frontend

# ID оффера в системе партнёрки (то же значение, что и OFFER_ID выше).
NEXT_PUBLIC_OFFER_ID=

# Сколько дней хранить реф-код в localStorage.
NEXT_PUBLIC_REF_TTL_DAYS=7

# CloudPayments Public ID (только для Variant B — собственная платёжная форма).
NEXT_PUBLIC_CP_PUBLIC_ID=

# Куда вернуть пользователя после оплаты, например https://your-domain.com/lk
NEXT_PUBLIC_PAYMENT_BACK_URL=

# ── SEO ───────────────────────────────────────────────────────────────────────
# Канонический адрес сайта: с протоколом, без слэша на конце.
# Из него строятся canonical, og:url, sitemap.xml и robots.txt.
# Переменная NEXT_PUBLIC_*, поэтому docker-compose.prod.yml передаёт её
# в сборку фронта как build arg. Изменили домен -> пересобрать frontend:
#   docker compose -f docker-compose.prod.yml build frontend
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Коды подтверждения прав в Яндекс.Вебмастере и Google Search Console
# (значение атрибута content из предложенного метатега). Пусто — тега не будет.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── Режим отладки ────────────────────────────────────────────────────────────
# true: включает /docs, подробные ошибки. Только для разработки.
# false: для продакшна (обязательно).
DEBUG=true
